#pragma kernel CSMain

#define SAMPLE_COUNT 16
#define PI 3.14159265359

struct SampleData {
    float4 position;
    float4 forward;
    float4 up;
    float4 right;
};

struct RingParams {
    float4 colorAndGlow;
    float4 motionDirSign;
    float4 avgFwdRadiusSlope;
    float4 tangent;
    float4 right;
    float4 plane;
    float4 zPosRadiusIsZero;
    float4 offsetSweepOpac;
    float4 lengthRounded;
};

struct RingVertex {
    float4 position;
    float4 normal;
    float4 tangent;
    float4 color;
    float4 uv;
    float4 bladeDir;
};

StructuredBuffer<SampleData> _Samples;
StructuredBuffer<RingParams> _Rings;
RWStructuredBuffer<RingVertex> _RingVertices;

int _RingVerts;
int _RingCount;

SampleData SampleAlongCurve(float t)
{
    t = saturate(t);
    float scaledT = t * (SAMPLE_COUNT - 1);
    int idx = (int)floor(scaledT);
    int nextIdx = min(idx + 1, SAMPLE_COUNT - 1);
    float localT = scaledT - (float)idx;

    SampleData a = _Samples[idx];
    SampleData b = _Samples[nextIdx];

    SampleData result;
    result.position = lerp(a.position, b.position, localT);
    result.forward = lerp(a.forward, b.forward, localT);
    result.up = lerp(a.up, b.up, localT);
    result.right = lerp(a.right, b.right, localT);
    return result;
}

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint globalId = id.x;
    uint vertIdx = globalId % (uint)_RingVerts;
    uint ringIdx = globalId / (uint)_RingVerts;

    if (ringIdx >= (uint)_RingCount || vertIdx >= (uint)_RingVerts)
        return;

    RingParams ring = _Rings[ringIdx];

    float zPos = ring.zPosRadiusIsZero.x;
    float radius = ring.zPosRadiusIsZero.y;
    float isZero = ring.zPosRadiusIsZero.z;
    float signVal = ring.motionDirSign.w;
    float3 motionDir = ring.motionDirSign.xyz;
    float3 tangentVec = ring.tangent.xyz;
    float3 rightVec = ring.right.xyz;
    float3 avgFwd = ring.avgFwdRadiusSlope.xyz;
    float radiusSlope = ring.avgFwdRadiusSlope.w;
    float2 offset = ring.offsetSweepOpac.xy;
    float sweepRatio = ring.offsetSweepOpac.z;
    float opacity = ring.offsetSweepOpac.w;
    float3 planeNormal = ring.plane.xyz;
    float4 color = ring.colorAndGlow;
    float partLength = ring.lengthRounded.x;
    float enableRounded = ring.lengthRounded.y;

    float theta = 2.0 * PI * (float)vertIdx / (float)_RingVerts;
    float3 offsetDir = signVal * cos(theta) * tangentVec + sin(theta) * rightVec;

    float dotVal = dot(offsetDir, motionDir);
    float tSample = (dotVal + 1.0) * 0.5;

    SampleData interpSample = SampleAlongCurve(tSample);

    float3 ringCenter = interpSample.position.xyz + interpSample.forward.xyz * zPos;
    ringCenter += interpSample.up.xyz * offset.y + interpSample.right.xyz * offset.x;

    float3 normal = signVal * offsetDir;
    if (enableRounded > 0.5)
    {
        if (isZero > 0.5)
        {
            float zRatio = 2.0 * (zPos / partLength) - 1.0;
            float absZ = abs(zRatio);
            float s = zRatio >= 0 ? 1.0 : -1.0;
            float endCapTerm = s * (0.12 * pow(absZ, 9.0) + pow(absZ * 0.99, 171.0));
            normal += avgFwd * 2.0 * endCapTerm;
        }
        else
        {
            normal -= avgFwd * radiusSlope;
        }
    }

    float3 vertexPos = ringCenter + offsetDir * (isZero > 0.5 ? 0.0 : radius);

    uint outIdx = ringIdx * (uint)_RingVerts + vertIdx;

    RingVertex v;
    v.position = float4(vertexPos, 1.0);
    v.normal = float4(normal, 0.0);
    v.tangent = float4(planeNormal, 0.0);
    v.color = color;
    float sweepFade = clamp((sweepRatio - 0.7) * 0.01, 0.0, 5.0);
    v.uv = float2(tSample, sweepFade);
    v.bladeDir = float4(interpSample.forward.xyz, opacity);

    _RingVertices[outIdx] = v;
}
